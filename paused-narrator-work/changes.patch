+    @Test
+    fun manualNpcRegenerateAndContinuePreserveNpcIdentityAndEarlierNarration() = runBlocking {
+        val provider = TurnProvider(listOf("Arthur waits.", "Hello.", "Welcome.", "Try again.", " More."))
+        val h = createHarness(provider, ResponseLengthProfile.NORMAL, narratorEnabled = true, npcBankEnabledInitially = true)
+        database.npcDao().insertDossier(NpcDossierEntity(npcId = "arthur", chatId = h.chatId, displayName = "Arthur", keepInScene = true))
+        h.viewModel.onDraftChanged("Arthur?")
+        h.viewModel.sendMessage()
+        val messages = awaitDedicatedTurn(h, 4)
+        val original = messages.single { it.speakerType == SpeakerType.NPC }
+        h.viewModel.regenerateMessage(original.messageId)
+        val withVariant = awaitDedicatedTurn(h, 5)
+        val replacement = withVariant.single { it.speakerType == SpeakerType.NPC && it.isPrimaryVariant }
+        assertEquals("arthur", replacement.speakerId)
+        assertEquals(original.variantGroupId, replacement.variantGroupId)
+        assertTrue(provider.requests[3].any { it.content == "Narrator: Arthur waits." })
+        assertFalse(provider.requests[3].any { it.content.contains("Welcome.") || it.content == "Arthur: Hello." })
+        h.viewModel.continueMessage(replacement.messageId)
+        withTimeout(15_000) { h.messageRepository.getMessagesForChat(h.chatId).first { it.any { m -> m.messageId == replacement.messageId && m.content == "Try again. More." } } }
+        assertEquals(5, provider.requests.size)
+    }
