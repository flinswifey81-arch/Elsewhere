+    @Test
+    fun stopNarratorKeepsAttributedPartialAndPreventsRemainingAutomaticCalls() = runBlocking {
+        val provider = object : ModelProvider {
+            var calls = 0
+            override suspend fun getModels() = emptyList<OpenRouterModel>()
+            override suspend fun getEndpoints(modelId: String) = emptyList<ProviderEndpoint>()
+            override fun streamResponse(messages: List<RoleplayMessage>, options: GenerationOptions) = flow {
+                calls++
+                emit(StreamEvent.Content("Rain begins."))
+                awaitCancellation()
+            }
+        }
+        val h = createHarness(provider, ResponseLengthProfile.NORMAL, narratorEnabled = true)
+        h.viewModel.onDraftChanged("Look outside.")
+        h.viewModel.sendMessage()
+        withTimeout(15_000) { h.viewModel.uiState.first { it is ChatUiState.Success && it.streamingContent == "Rain begins." } }
+        h.viewModel.stopGeneration()
+        withTimeout(15_000) { h.viewModel.uiState.first { it is ChatUiState.Success && it.partialStopped && !it.automaticTurnRunning } }
+        h.viewModel.keepPartial()
+        val messages = awaitDedicatedTurn(h, 2)
+        assertEquals(SpeakerType.NARRATOR, messages.last().speakerType)
+        assertEquals("Narrator", messages.last().speakerDisplayNameSnapshot)
+        assertEquals(1, provider.calls)
+        assertTrue(h.messageRepository.getGenerationMetadata(messages.last().messageId)!!.isPartial)
+    }
+
+    private suspend fun awaitDedicatedTurn(h: Harness, count: Int): List<MessageEntity> {
+        withTimeout(15_000) { h.viewModel.uiState.first { it is ChatUiState.Success && it.messages.size == count && !it.isGenerating && !it.automaticTurnRunning && !it.partialResolutionInProgress } }
+        return h.messageRepository.getMessagesForChatOnce(h.chatId)
+    }
+
+    private class TurnProvider(private val replies: List<String?>) : ModelProvider {
+        val requests = mutableListOf<List<RoleplayMessage>>()
+        override suspend fun getModels() = emptyList<OpenRouterModel>()
+        override suspend fun getEndpoints(modelId: String) = emptyList<ProviderEndpoint>()
+        override fun streamResponse(messages: List<RoleplayMessage>, options: GenerationOptions) = flow {
+            val index = requests.size
+            requests += messages
+            val reply = replies.getOrNull(index)
+            if (reply == null) emit(StreamEvent.Error(IllegalStateException("Temporary provider failure")))
+            else { emit(StreamEvent.Content(reply)); emit(StreamEvent.Done(null)) }
+        }
+    }
+
