+    /** One explicit Send permits at most narrator + two relevant NPCs + one main Character. */
+    private fun runAutomaticQueue(dataRevision: AppDataRevision) {
+        if (automaticJob?.isActive == true || hasCoopRoom()) return
+        updateSuccessState { it.copy(automaticTurnRunning = true) }
+        automaticJob = viewModelScope.launch {
+            try {
+                while (automaticQueue.isNotEmpty()) {
+                    val speaker = automaticQueue.first
+                    retrySpeaker = speaker
+                    val messages = hidePersistedNpcControlRegions(messageRepository.getMessagesForChatOnce(chatId))
+                        .filter { it.isPrimaryVariant && ContextResetPolicy.includes(it, chatSummary?.chat?.contextResetOrderIndex) }
+                    val current = messages.lastOrNull() ?: break
+                    val job = startGenerationInternal(current, messages.dropLast(1), characterId = speaker.id,
+                        speakerType = speaker.type, dataRevision = dataRevision)
+                    job?.join()
+                    if (!lastGenerationSucceeded) break
+                    retrySpeaker = null
+                    automaticQueue.pollFirst()
+                    if (speaker.type == SpeakerType.NARRATOR) {
+                        val freshHistory = hidePersistedNpcControlRegions(messageRepository.getMessagesForChatOnce(chatId))
+                            .filter { it.isPrimaryVariant && ContextResetPolicy.includes(it, chatSummary?.chat?.contextResetOrderIndex) }
+                        val summary = chatSummary ?: break
+                        val state = _uiState.value as? ChatUiState.Success ?: break
+                        if (npcRepository?.getSettings(chatId)?.isEnabled == true) {
+                            val excludedNames = (summary.characters.map { it.displayName } + summary.personas.map { it.displayName }).map { it.lowercase() }.toSet()
+                            SupportingCastPlanner.select(npcRepository.getProjectedDossiers(chatId).filter {
+                                it.displayName.lowercase() !in excludedNames
+                            }, freshHistory).forEach { npc ->
+                                automaticQueue.add(GenerationSpeaker(npc.npcId, npc.displayName, SpeakerType.NPC))
+                            }
+                        }
+                        val main = if (summary.chat.chatType == ChatType.GROUP) {
+                            state.groupCharacters.firstOrNull { it.isActive && it.character.characterId == state.selectedGroupCharacterId }?.character
+                        } else summary.characters.firstOrNull()
+                        main?.let { automaticQueue.add(GenerationSpeaker(it.characterId, it.displayName, SpeakerType.CHARACTER)) }
+                    }
+                }
+            } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                updateSuccessState { it.copy(generationError = "The next speaker could not start. Saved replies were kept; Retry resumes the unfinished turn.") }
+            } finally {
+                updateSuccessState { it.copy(automaticTurnRunning = false) }
+            }
+        }
+    }
+
+    fun generateSpeaker(speaker: GenerationSpeaker) {
+        val state = _uiState.value as? ChatUiState.Success ?: return
+        if (!canMutateMessageNow() || inChatToolInProgress) return
+        if (hasCoopRoom()) {
+            updateSuccessState { it.copy(generationError = "Dedicated narrator and NPC turns are available in local chats. End co-op to use them.") }
+            return
+        }
+        automaticQueue.clear()
+        generationStartInProgress = true
+        retrySpeaker = speaker
+        viewModelScope.launch {
+            try {
+                val messages = hidePersistedNpcControlRegions(messageRepository.getMessagesForChatOnce(chatId))
+                    .filter { it.isPrimaryVariant }
+                val current = messages.lastOrNull() ?: return@launch
+                val job = startGenerationInternal(current, messages.dropLast(1), characterId = speaker.id, speakerType = speaker.type)
+                job?.join()
+                if (lastGenerationSucceeded) retrySpeaker = null
+            } catch (cancelled: kotlinx.coroutines.CancellationException) { throw cancelled }
+            catch (_: Exception) {
+                updateSuccessState { it.copy(generationError = "This speaker could not start. You can retry the turn.") }
+            } finally { generationStartInProgress = false }
+        }
+    }
